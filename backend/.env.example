NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/haoyi

# Security: generate long random values before production use
SESSION_SECRET=replace-with-at-least-32-random-bytes
COOKIE_NAME=haoyi.sid
CSRF_COOKIE_NAME=haoyi.csrf
DATA_ENCRYPTION_KEY=replace-with-32-byte-base64-or-long-random-secret

# Admin path is intentionally not linked from the public website
ADMIN_PATH=/secure-admin-portal
ADMIN_BOOTSTRAP_KEY=replace-with-one-time-admin-bootstrap-key

# Optional CORS allow-list, comma separated
CORS_ORIGINS=http://localhost:3000

# Upload limits
UPLOAD_MAX_BYTES=5242880

# Payment webhook shared secret
WEBHOOK_SECRET=replace-with-payment-webhook-secret