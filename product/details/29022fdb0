    <script>
    (function(){
        if (window.innerWidth >= 992) return;

        var lastY = window.scrollY;
        var idleTimer = null;
        var fab = null;
        var scrollTop = null;
        var hidden = false;
        var threshold = 10;

        function getEls(){
            if (!fab) fab = document.querySelector('.fab-group');
            if (!scrollTop) scrollTop = document.querySelector('.scroll-top');
        }

        function hide(){
            if (hidden) return;
            hidden = true;
            getEls();
            if (fab && !fab.classList.contains('open')) fab.classList.add('scroll-hidden');
            if (scrollTop) scrollTop.classList.add('scroll-hidden');
        }

        function show(){
            if (!hidden) return;
            hidden = false;
            getEls();
            if (fab) fab.classList.remove('scroll-hidden');
            if (scrollTop) scrollTop.classList.remove('scroll-hidden');
        }

        window.addEventListener('scroll', function(){
            var y = window.scrollY;
            var delta = y - lastY;
            lastY = y;

            if (idleTimer) clearTimeout(idleTimer);

            if (delta > threshold) {
                hide();
            } else if (delta < -threshold) {
                show();
            }

            idleTimer = setTimeout(show, 1500);
        }, { passive: true });
    })();
    </script>

    
    
