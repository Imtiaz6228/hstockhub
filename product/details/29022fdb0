        function check(a) {
            if (!a || !a.href) return null;
            if (a.target === '_blank' || a.hasAttribute('download')) return null;
            try {
                var u = new URL(a.html);
                if (u.origin !== location.origin) return null;
                if (u.pathname === location.pathname && u.search === location.search) return null;
                return a.href;
            } catch(e) { return null; }
        }

        document.addEventListener('pointerenter', function(e) {
            var a = e.target.closest && e.target.closest('a');
            var url = check(a);
            if (!url) return;
            timer = setTimeout(function() { prefetch(url); }, 65);
        }, true);

        document.addEventListener('pointerleave', function(e) {
            if (e.target.closest && e.target.closest('a') && timer) {
                clearTimeout(timer);
                timer = null;
            }
        }, true);

