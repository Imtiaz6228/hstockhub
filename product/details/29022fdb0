        <script>
    "use strict";
    // 服务器端通知数据
    const __serverNotifications = [];
    const __serverErrors = [];

    // 等待 Vue 组件加载后显示通知
    function __showVueNotifications() {
        if (window.$toast) {
            __serverNotifications.forEach(function(n) {
                const type = n[0] || 'info';
                const msg = n[1] || '';
                if (window.$toast[type]) {
                    window.$toast[type](msg);
                }
            });
            __serverErrors.forEach(function(err) {
                window.$toast.error(err);
            });
        } else {
            // Vue 还没加载，稍后重试
            setTimeout(__showVueNotifications, 100);
        }
    }

    // DOM 加载后显示
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function() {
            setTimeout(__showVueNotifications, 200);
        });
    } else {
        setTimeout(__showVueNotifications, 200);
    }

    // 全局 notify 函数 - 兼容现有调用
    function notify(status, message) {
        function show(type, msg) {
            if (window.$toast && window.$toast[type]) {
                window.$toast[type](msg);
            } else {
                // 降级到 console
                console.log('[notify]', type, msg);
            }
        }
        if (typeof message === 'string') {
            show(status, message);
        } else if (Array.isArray(message)) {
            message.forEach(function(m) { show(status, m); });
        } else if (typeof message === 'object') {
            Object.values(message).forEach(function(m) { show(status, m); });
        }
    }
</script>

    
            
            
