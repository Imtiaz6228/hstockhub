(function(){
      return;
  
  const btn = document.getElementById('btnDm');
  const dmModalEl = document.getElementById('dmModal');
  const dmBodyEl  = document.getElementById('dmBody');
  const dmTitleEl = document.getElementById('dmModalLabel');

  if (!btn || !dmModalEl || !dmBodyEl) return;
  if (!(window.bootstrap && bootstrap.Modal)) return;

  const dmModal = bootstrap.Modal.getOrCreateInstance(dmModalEl);
  const CSRF = "6w6bqR2FbxXKERQgRygwbiuVvyvXZUaykBVkU7nj";
  const START_URL = "../../dm/start/0";
  const CTX_TPL = "29022fdb0\/\/xiaokaz.com\/dm\/context\/:id";
  const CTX_TTL_MIN = 50;

  const SELLER_LABEL = "Seller#0";

  function escapeHtml(str){
    return String(str || '')
      .replaceAll('&','&amp;')
      .replaceAll('<','&lt;')
      .replaceAll('>','&gt;')
      .replaceAll('"','&quot;')
      .replaceAll("'","&#039;");
  }
  function setLoading(text){
    dmBodyEl.innerHTML = `<div class="text-muted">${escapeHtml(text || i18n.preparingChat)}</div>`;
  }
  function setIframe(url){
    dmBodyEl.innerHTML = `<iframe class="pd-dm-frame" src="${escapeHtml(url)}" loading="lazy"></iframe>`;
  }

  function getCurrentVariant(){
    const active = document.querySelector('.variantBtn.active');
    if (active){
      const id = parseInt(active.getAttribute('data-id') || '0', 10) || 0;
      const txt = active.getAttribute('data-text') || active.textContent || '';
      return { id, name: String(txt).trim() };
    }
    return { id: 29022, name: "TikTok \u514b\u9686\u53f7 \u591a\u56fd \u6cd5\u56fd - \u5fb7\u56fd - \u82f1\u56fd - \u7f8e\u56fd - \u97e9\u56fd - \u65e5\u672c\uff08\u90ae\u7bb1\u5b58\u6d3b\uff09" };
  }

  async function sendContextOnce(ticketId, productId, productName){
    if (!CTX_TPL) return;

    const key = `dmctx:${ticketId}:${productId}`;
    const now = Date.now();
    const last = parseInt(localStorage.getItem(key) || '0', 10) || 0;

    if (last && (now - last) < CTX_TTL_MIN * 60 * 1000) return;
    localStorage.setItem(key, String(now));

    const url = CTX_TPL.replace(':id', encodeURIComponent(String(ticketId)));

    await fetch(url, {
      method:'POST',
      headers:{
        'X-CSRF-TOKEN': CSRF,
        'Accept':'application/json',
        'X-Requested-With':'XMLHttpRequest',
        'Content-Type':'application/x-www-form-urlencoded;charset=UTF-8'
      },
      credentials:'same-origin',
      body: new URLSearchParams({
        product_id: String(productId || 0),
        product_name: String(productName || ''),
        product_url: "https://xiaokaz.com/product/details/29022",
        ttl_minutes: String(CTX_TTL_MIN),
      })
    }).catch(()=>{});
  }

  dmModalEl.addEventListener('hidden.bs.modal', function(){
    setLoading(i18n.preparingChat);
  });

  function openChat(embedUrl, ticketId){
    if (dmTitleEl) dmTitleEl.textContent = i18n.chatWith.replace(':name', SELLER_LABEL);
    setIframe(embedUrl);
    dmModal.show();

    const v = getCurrentVariant();
    const ctxName = (v.name ? (i18n.productInquiry + ': ' + v.name) : i18n.productInquiry);
    sendContextOnce(ticketId, v.id || 29022, ctxName);
  }

  btn.addEventListener('click', async function(){
    // 已经拿过 embed_url：直接打开
    if (btn.dataset.embedUrl && btn.dataset.ticketId){
      openChat(btn.dataset.embedUrl, btn.dataset.ticketId);
      return;
    }

    if (btn.dataset.locked === '1') return;
    btn.dataset.locked = '1';

    const origin = btn.innerHTML;
    btn.classList.add('disabled');
    btn.innerHTML = '<span class="chip-icon"><i class="las la-spinner la-spin"></i></span> ' + i18n.connecting;

    try{
      setLoading(i18n.preparingChat);
      dmModal.show();

      const res = await fetch(START_URL, {
        method:'POST',
        headers:{ 'X-CSRF-TOKEN': CSRF, 'Accept':'application/json' },
        credentials:'same-origin',
        body:new URLSearchParams()
      });

      const data = await res.json().catch(()=>null);
      if (!data || data.status !== 'success'){
        throw new Error(data?.message || i18n.unableToOpenChat);
      }

      btn.dataset.embedUrl = data.embed_url || '';
      btn.dataset.ticketId = String(data.ticket_id || '');

      openChat(data.embed_url, data.ticket_id);

      btn.innerHTML = '<span class="chip-icon"><i class="las la-comments"></i></span> ' + i18n.chatting;
    }catch(err){
      console.error(err);
      alert(err.message || i18n.networkErrorShort);
      try{ dmModal.hide(); }catch(_){}
      btn.innerHTML = origin;
    }finally{
      btn.dataset.locked = '0';
      btn.classList.remove('disabled');
    }
  });
})();

