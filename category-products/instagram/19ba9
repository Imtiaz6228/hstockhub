@keyframes mbcFadeIn { from{opacity:0;transform:translateY(10px)} to{opacity:1;transform:none} }
.mbc-peek{
    position:relative;
    overflow:hidden;
    aspect-ratio:auto !important;
    height:auto !important;
    width:100%; max-width:none !important; margin:0 0 22px;   /* 与内容区(.container)同宽 */
    padding:10px 0;                                            /* 给倾斜/阴影留呼吸 */
    background:transparent !important; border:0 !important;
    box-shadow:none !important; border-radius:0 !important;
    animation:mbcFadeIn .5s cubic-bezier(.16,1,.3,1) both;
    cursor:grab;
}
.mbc-peek:active{ cursor:grabbing; }
.mbc-peek .mbc-track{
    display:flex; align-items:center; gap:16px;
    transition:transform .55s cubic-bezier(.22,1,.36,1);
    will-change:transform;
}
/* 每张:默认略小、淡显(平铺,无 3D,无叠压)。露边看着是"淡图"而非黑影 */
.mbc-peek .mbc-slide{
    position:relative !important;
    flex:0 0 90%;                  /* 主图占比大 → 醒目不扁 */
    opacity:.6;                    /* 调高:露边读作"淡淡的图",不发灰像影子 */
    transform:scale(.95);
    z-index:1;
    transition:transform .55s cubic-bezier(.22,1,.36,1), opacity .45s ease, box-shadow .45s ease;
    border-radius:18px; overflow:hidden;
    box-shadow:none;               /* 侧图不投影,避免黑边 */
    cursor:pointer;
}
.mbc-peek .mbc-slide img{
    width:100%; height:auto; display:block;
    aspect-ratio:1200/180; object-fit:cover;
    border-radius:18px; box-shadow:none !important;
}
.mbc-peek .mbc-slide.is-prev:hover, .mbc-peek .mbc-slide.is-next:hover{ opacity:.78; }
/* 主图:清晰、满色,不加投影(避免图片下方出现灰影/阴线)*/
.mbc-peek .mbc-slide.active{
    opacity:1; transform:scale(1);
    z-index:3; cursor:default;
    box-shadow:none;
}
/* 导航按钮:hover 显现,圆角玻璃 */
.mbc-peek .mbc-btn{
    position:absolute; top:50%; transform:translateY(-50%); z-index:6;
    width:40px; height:40px; border-radius:12px; border:0;
    background:rgba(255,255,255,.85); color:#0f172a;
