<script>
(function(){
    // 发货类型提示
    let activeTooltip = null;
    document.addEventListener('click', function(e) {
        const badge = e.target.closest('.delivery-tip');

        // 点击其他地方关闭提示
        if (!badge && activeTooltip) {
            activeTooltip.remove();
            activeTooltip = null;
            return;
        }

        if (!badge) return;
        e.stopPropagation();

        // 如果已有提示则关闭
        if (activeTooltip) {
            activeTooltip.remove();
            activeTooltip = null;
        }

        const tip = badge.dataset.tip;
        if (!tip) return;

        // 创建提示元素
        const tooltip = document.createElement('div');
        tooltip.className = 'delivery-tooltip';
        tooltip.textContent = tip;
        document.body.appendChild(tooltip);

        // 计算位置
        const rect = badge.getBoundingClientRect();
        const tooltipRect = tooltip.getBoundingClientRect();
        let top = rect.top - tooltipRect.height - 10;
        let left = rect.left + (rect.width / 2) - (tooltipRect.width / 2);

        // 如果上方空间不够，显示在下方
        if (top < 10) {
            top = rect.bottom + 10;
            tooltip.classList.add('pos-bottom');
        } else {
            tooltip.classList.add('pos-top');
        }

        // 确保不超出屏幕
        left = Math.max(10, Math.min(left, window.innerWidth - tooltipRect.width - 10));

        tooltip.style.top = top + 'px';
        tooltip.style.left = left + 'px';
        activeTooltip = tooltip;

        // 3秒后自动关闭
        setTimeout(() => {
            if (activeTooltip === tooltip) {
                tooltip.remove();
                activeTooltip = null;
            }
        }, 3000);
    });

    const favUrl  = "../../user/favorites/toggle.html";
    const csrfTok = "6w6bqR2FbxXKERQgRygwbiuVvyvXZUaykBVkU7nj";
    if (!favUrl) return;

    document.addEventListener('click', function(e){
        const btn = e.target.closest('.fav-btn');
        if (!btn) return;

        const pid = btn.getAttribute('data-product-id');
        if (!pid || btn.dataset.loading === '1') return;

        btn.dataset.loading = '1';

        fetch(favUrl, {
            method: 'POST',
            headers: {
                'X-CSRF-TOKEN': csrfTok,
                'Accept': 'application/json',
                'X-Requested-With': 'XMLHttpRequest',
                'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8'
            },
            body: new URLSearchParams({product_id: pid})
        }).then(async res => {
            const ct   = res.headers.get('content-type') || '';
            const data = ct.includes('application/json') ? await res.json().catch(()=>null) : null;
            if (!res.ok || !data || data.status !== 'success') {
                alert(data?.message || 'Operation failed, please try again');
                return;
            }
            const action   = data.action || 'followed';
            const followed = action === 'followed';
            btn.dataset.followed = followed ? '1' : '0';
            btn.classList.toggle('is-followed', followed);
            btn.title = followed ? 'Followed' : 'Follow this product';
        }).catch(err => {
            console.error(err);
            alert('Network error, please try again');
        }).finally(() => {
            btn.dataset.loading = '0';
        });
    });
})();
</script>
