.mbc-peek .mbc-dot{
    width:7px; height:7px; border-radius:4px; border:0; cursor:pointer;
    background:rgba(255,255,255,.55);
    transition:width .3s cubic-bezier(.16,1,.3,1), background .25s ease;
}
.mbc-peek .mbc-dot:hover{ background:rgba(255,255,255,.85); }
