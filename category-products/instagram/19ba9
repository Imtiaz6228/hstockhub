.mbc-peek:hover .mbc-btn{ opacity:1; }
.mbc-peek .mbc-btn:hover{ background:#fff; }
.mbc-peek .mbc-prev{ left:12px; }
.mbc-peek .mbc-next{ right:12px; }
/* 圆点:浮在底部中央,主题蓝细条 */
.mbc-peek .mbc-dots{
    position:absolute !important; left:50%; bottom:12px; transform:translateX(-50%);
    display:flex; gap:7px; z-index:6;
    background:rgba(15,23,42,.28) !important; backdrop-filter:blur(8px);
